# Copy to .env and change every value before deploying
DEBUG=0
HTTPS=0            # set to 1 once you serve the site over HTTPS
SECRET_KEY=change-me-to-a-long-random-string
DB_PASSWORD=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost
FRONTEND_URL=http://localhost
PUBLIC_API_URL=http://localhost:8000/api
# Hidden admin panel credentials (set these before deploying):
ADMIN_PANEL_USER=admin
ADMIN_PANEL_PASSWORD=change-me-strong-password
ADMIN_URL=change-me-secret-path/

# Real email (otherwise links print in the backend log):
# EMAIL_HOST=smtp.example.com
# EMAIL_USER=
# EMAIL_PASSWORD=
# DEFAULT_FROM_EMAIL=Wilmark Technologies <no-reply@yourdomain.com>
